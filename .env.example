NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://traceforge:traceforge@localhost:5432/traceforge?schema=public
API_AUTH_TOKEN=replace-with-a-long-random-token
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=service-account@example.com
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-replace-with-a-rotated-app-level-token
# Investigation destination channel ID (right-click channel → View channel details → copy channel ID).
SLACK_INVESTIGATION_CHANNEL_ID=C9876543210
# Optional: absolute path to a managed Codex CLI. Omit to use @openai/codex-sdk's bundled CLI.
# CODEX_COMMAND=/usr/local/bin/codex
CODEX_TIMEOUT_MS=1800000
WORKSPACE_ROOT=./workspaces
REPOSITORIES_CONFIG_PATH=./repositories.yaml
SLACK_UPDATE_INTERVAL_MS=1000
SLACK_STREAMING_MODE=auto
SLACK_APPROVER_USER_IDS=U0123456789
SLACK_APPROVAL_TIMEOUT_MINUTES=60
